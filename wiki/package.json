{
  "name": "wiki-xray-network-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "description": "The directory for XRAY projects, developer tools, standards, and mini apps.",
  "homepage": "https://wiki.xraynetwork.io/",
  "scripts": {
    "dev": "rspress dev --host 0.0.0.0 --port 10005",
    "build": "rspress build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "preview": "rspress preview --host 0.0.0.0 --port 10005"
  },
  "devDependencies": {
    "@rspress/core": "2.0.21",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "wrangler": "4.54.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
