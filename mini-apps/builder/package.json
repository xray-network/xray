{
  "name": "@xray-network/xray-mini-app-builder",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "XRAY/Network <hello@xray.app>",
  "description": "XRAY Mini App Builder - Build mini apps for the XRAY ecosystem",
  "homepage": "https://xray.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xray-network/xray.git",
    "directory": "mini-apps/builder"
  },
  "bugs": {
    "url": "https://github.com/xray-network/xray/issues"
  },
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host --port 7210",
    "build": "react-router build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\"",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"tests/**/*.{ts,mjs,html}\" package.json package-lock.json vitest.config.ts playwright.config.ts README.md \".agents/spectre/implementations/0017-IMPL-*.md\""
  },
  "imports": {
    "#tailwind.css": "app/styles/tailwind.css"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@heroicons/react": "^2.2.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@xray-network/xray-js": "^4.0.0",
    "antd": "^6.6.0",
    "classnames": "^2.5.1",
    "isbot": "^5.1.27",
    "lodash": "^4.17.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/lodash": "^4.17.18",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.8.3",
    "vite": "^7.1.4",
    "vite-plugin-svgr": "^4.5.0",
    "vite-plugin-wasm": "^3.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.45.0"
  }
}
