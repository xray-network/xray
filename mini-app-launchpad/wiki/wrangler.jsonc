{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wiki-mini-apps-launchpad-docs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "wiki.xraynetwork.io/mini-apps/launchpad",
      "zone_name": "xraynetwork.io"
    },
    {
      "pattern": "wiki.xraynetwork.io/mini-apps/launchpad/*",
      "zone_name": "xraynetwork.io"
    }
  ]
}
